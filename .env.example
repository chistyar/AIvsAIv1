# Google AI Studio API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Hardware Station REST API URL (HTTP or HTTPS)
STATION_BASE_URL=http://localhost:8000

# Set to true to disable SSL certificate verification for self-signed HTTPS on Raspberry Pi
STATION_VERIFY_SSL=false

# File path to log all thoughts, tool calls, and observations in real time
AGENT_THINKING_LOG=agent_thinking.log
